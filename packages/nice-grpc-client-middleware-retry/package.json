{
  "name": "nice-grpc-client-middleware-retry",
  "version": "3.1.15",
  "description": "Retry client middleware for nice-grpc",
  "repository": {
    "type": "git",
    "url": "https://github.com/deeplay-io/nice-grpc.git",
    "directory": "packages/nice-grpc-client-middleware-retry"
  },
  "homepage": "https://github.com/deeplay-io/nice-grpc/tree/master/packages/nice-grpc-client-middleware-retry#readme",
  "bugs": {
    "url": "https://github.com/deeplay-io/nice-grpc/issues"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "test": "vitest run",
    "build": "tsc -P tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "build:proto": "grpc_tools_node_protoc --ts_proto_out=./fixtures --ts_proto_opt=outputServices=generic-definitions,useExactTypes=false,esModuleInterop=true -I fixtures fixtures/*.proto",
    "prepare": "npm run build:proto"
  },
  "author": "Daniel Lytkin <aikoven@deeplay.io>",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "grpc-tools": "^1.13.1",
    "nice-grpc": "^2.1.16",
    "ts-proto": "^2.5.1"
  },
  "dependencies": {
    "abort-controller-x": "^0.5.0",
    "nice-grpc-common": "^2.0.3"
  }
}
